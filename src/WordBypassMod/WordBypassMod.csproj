<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WordBypassMod</AssemblyName>
    <RootNamespace>WordBypassMod</RootNamespace>
    <!-- 离线构建时不访问 nuget.org 拉漏洞库 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CesiumLoader.SDK">
      <HintPath>..\..\lib\CesiumLoader.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstralParty.Runtime">
      <HintPath>..\..\refs\game\AstralParty.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\refs\game\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="WordBypassMod.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
